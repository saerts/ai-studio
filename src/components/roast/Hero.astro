---
import OldSite from './OldSite.astro';
---

<section id="start" class="t" style="max-width: 1280px; margin: 0 auto; padding: clamp(32px, 5vw, 72px) 24px clamp(72px, 9vw, 130px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: clamp(48px, 6vw, 88px); align-items: center">
<div>
<p class="note p1" style="margin: 0 0 18px; font-family: Caveat, cursive; font-size: clamp(28px, 2.6vw, 38px); line-height: 1; color: var(--pen); rotate: -3deg; transform-origin: left">eerlijk gezegd...</p>
<h1 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(54px, 8.2vw, 128px); line-height: .9; letter-spacing: -.045em">
<span class="slam">Je website</span>
<span class="slam d1">kost je</span>
<span class="slam d2"><span style="position: relative; display: inline-block">klanten.
<svg viewBox="0 0 300 120" preserveAspectRatio="none" aria-hidden="true" style="position: absolute; left: -7%; top: -8%; width: 114%; height: 124%; overflow: visible"><path class="pen p1" pathLength="1" stroke-width="5" d="M18 66 C 10 22, 120 4, 212 10 C 286 16, 300 52, 284 84 C 262 118, 96 122, 34 100 C 2 86, 8 40, 60 22"></path></svg>
</span></span>
</h1>
<p style="margin: 36px 0 0; max-width: 500px; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.5">Elke dag, in stilte. Bezoekers klagen niet, ze vertrekken gewoon. <span class="hl" style="background-image: linear-gradient(var(--marker), var(--marker)); font-weight: 700">Wij zeggen het wel.</span></p>
<form data-roast-hero action="#aanvraag" style="margin-top: 36px; max-width: 540px; display: flex; flex-direction: column; gap: 10px">
<label for="roast-url" style="font-weight: 700; font-size: 15px">Plak je URL, wij halen de rode pen boven</label>
<div style="display: flex; flex-wrap: wrap; border: 3px solid #111111; box-shadow: 6px 6px 0 #111111; background: #FFFFFF">
<input id="roast-url" type="url" placeholder="https://jouwbedrijf.be" style="flex: 1 1 220px; min-width: 0; min-height: 60px; padding: 0 18px; border: 0; background: transparent; color: #111111; font: 500 18px Archivo, sans-serif">
<a href="#aanvraag" data-roast-go style="flex: 0 0 auto; background: var(--pen); color: #FFFFFF; text-decoration: none; font-weight: 700; font-size: 18px; padding: 0 26px; min-height: 60px; display: inline-flex; align-items: center; gap: 10px">Roast mijn site
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
<p style="margin: 6px 0 0; font-size: 15px; color: #555555">Gratis. Geen account. Geen verkooppraatje.</p>
</form>
</div>

<div class="float" style="position: relative">
<div role="img" aria-label="Een verouderde website, nagekeken met rode pen" data-tilt style="transform: perspective(1200px) rotate(-2.5deg); transition: transform .2s ease-out; position: relative">
<div class="mock" aria-hidden="true" style="filter: drop-shadow(14px 18px 0 rgba(17,17,17,.12))"><div class="in">
<OldSite />
</div></div>
<svg viewBox="0 0 600 390" preserveAspectRatio="none" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible">
<path class="pen p2" pathLength="1" stroke-width="4" d="M10 372 C 14 352, 150 350, 158 370 C 162 392, 20 396, 8 380 C 4 372, 20 360, 50 357"></path>
<path class="pen p3" pathLength="1" stroke-width="4" d="M14 250 C 8 180, 90 172, 150 176 C 226 182, 232 250, 214 296 C 190 332, 40 330, 18 290 C 8 270, 14 220, 40 196"></path>
<path class="pen p4" pathLength="1" stroke-width="4" d="M560 -30 C 540 0, 500 20, 452 44 M452 44 l 22 -2 M452 44 l 10 -20"></path>
<path class="pen p4" pathLength="1" stroke-width="4" d="M262 318 C 320 326, 420 322, 478 316 M264 326 C 330 334, 410 330, 474 324"></path>
</svg>
<span class="note p2" style="position: absolute; left: -3%; bottom: -15%; font: 700 clamp(26px, 3vw, 44px)/1 Caveat, cursive; color: var(--pen); rotate: -6deg">2011?!</span>
<span class="note p3" style="position: absolute; left: 6%; top: 52%; font: 700 clamp(22px, 2.4vw, 34px)/1 Caveat, cursive; color: var(--pen); rotate: -8deg; background: #FFFFFF; padding: 2px 8px">waar zijn de foto's?</span>
<span class="note p4" style="position: absolute; right: -2%; top: -17%; font: 700 clamp(24px, 2.6vw, 38px)/1 Caveat, cursive; color: var(--pen); rotate: 4deg">laadt 8 seconden</span>
<span class="note p4" style="position: absolute; right: 4%; bottom: 3%; font: 700 clamp(22px, 2.4vw, 34px)/1 Caveat, cursive; color: var(--pen); rotate: -3deg; background: #FFFFFF; padding: 2px 8px">14 MB. Echt?</span>
</div>
<svg class="spin" viewBox="0 0 140 140" aria-hidden="true" style="position: absolute; left: -34px; top: -44px; width: clamp(96px, 10vw, 140px); height: auto">
<circle cx="70" cy="70" r="68" style="fill: var(--marker)" stroke="#111111" stroke-width="3"></circle>
<path id="ring" d="M70 70 m-50 0 a50 50 0 1 1 100 0 a50 50 0 1 1 -100 0" fill="none"></path>
<text font-family="Archivo, sans-serif" font-weight="700" font-size="15" letter-spacing="3" fill="#111111"><textPath href="#ring">GRATIS ROAST · GRATIS ROAST · </textPath></text>
<path d="M70 46 l7 16 17 2 -13 12 4 17 -15 -9 -15 9 4 -17 -13 -12 17 -2z" fill="#111111"></path>
</svg>
</div>
</section>
