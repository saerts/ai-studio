---
import RoastLayout from '../components/layout/RoastLayout.astro';
import Nav from '../components/roast/Nav.astro';
import Hero from '../components/roast/Hero.astro';
import Tape from '../components/roast/Tape.astro';
import Bezoeker from '../components/roast/Bezoeker.astro';
import Rapport from '../components/roast/Rapport.astro';
import VoorNa from '../components/roast/VoorNa.astro';
import Stappen from '../components/roast/Stappen.astro';
import ZelfMetAI from '../components/roast/ZelfMetAI.astro';
import Prijzen from '../components/roast/Prijzen.astro';
import Aanvraag from '../components/roast/Aanvraag.astro';
import Wie from '../components/roast/Wie.astro';
import Closer from '../components/roast/Closer.astro';
import Hulpbalk from '../components/roast/Hulpbalk.astro';

const seoProps = {
  title: 'Je website kost je klanten. Gratis Website Roast',
  description:
    'Plak je URL en krijg een eerlijk rapport over je website, plus een gratis ontwerp van je nieuwe homepage. Websites vanaf €490, gemaakt met AI en nagekeken door een mens.',
  canonical: 'https://ai-studio44.com',
};
---

<RoastLayout {...seoProps}>
  <Nav />
  <Hero />
  <Tape />
  <Bezoeker />
  <Rapport />
  <VoorNa />
  <Stappen />
  <ZelfMetAI />
  <Prijzen />
  <Aanvraag />
  <Wie />
  <Closer />
  <Hulpbalk />
</RoastLayout>
