---
import RoastTextLayout from '../../components/layout/RoastTextLayout.astro';
import { beheerConfig, leesSessie } from '../../lib/beheer';

const cfg = beheerConfig();
if (cfg && leesSessie(cfg, Astro.cookies)) {
  return Astro.redirect('/beheer');
}
const status = Astro.url.searchParams.get('status');
const meldingen: Record<string, string> = {
  verstuurd: 'Als dit adres beheerder is, staat er nu een inloglink in je mailbox. De link werkt alleen in deze browser, binnen het kwartier.',
  ongeldig: 'Die link werkt niet (meer). Vraag een nieuwe aan, in dezelfde browser.',
  fout: 'De inloglink kon niet verstuurd worden. Probeer het over een paar minuten opnieuw.',
  wacht: 'Te veel pogingen. Wacht een minuut.',
  uitgelogd: 'Je bent uitgelogd.',
  uit: 'Het beheer staat uit: Supabase of ROAST_ADMIN_EMAILS is niet ingesteld.',
};
const seoProps = { title: 'Beheer: inloggen', noindex: true };
---

<RoastTextLayout {...seoProps}>
  <p class="roast-hand">alleen voor jou</p>
  <h1>Beheer</h1>
  {status && meldingen[status] && <p class="melding" role="status">{meldingen[status]}</p>}
  <form method="POST" action="/api/beheer/login" class="login">
    <label for="email">Je e-mailadres</label>
    <input id="email" name="email" type="email" required autocomplete="email" />
    <button type="submit" class="roast-cta btn">Stuur mij een inloglink</button>
  </form>
</RoastTextLayout>

<style>
  .melding {
    border: 2px solid #111;
    background: #fff8c9;
    padding: 14px 16px;
    font-weight: 700;
  }
  .login {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 420px;
  }
  .login label {
    font-weight: 700;
    font-size: 16px;
  }
  .login input {
    min-height: 52px;
    padding: 0 14px;
    border: 2px solid #111;
    font: 500 17px Archivo, sans-serif;
  }
  .login button {
    cursor: pointer;
    justify-content: center;
    min-height: 54px;
    font-family: Archivo, sans-serif;
  }
</style>
