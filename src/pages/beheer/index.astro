---
// Beheer: alle aanvragen uit Supabase, met knoppen om de status te wijzigen.
// De ochtendtaak pakt op wat op "goedgekeurd" staat.
import RoastLayout from '../../components/layout/RoastLayout.astro';
import { beheerConfig, leesSessie, lijstAanvragen, type BeheerRij } from '../../lib/beheer';
import { alleRoasts, isLive } from '../../roasts';

const cfg = beheerConfig();
const beheerder = cfg ? leesSessie(cfg, Astro.cookies) : null;
if (!cfg || !beheerder) {
  return Astro.redirect('/beheer/login');
}

let aanvragen: BeheerRij[] = [];
let leesFout = false;
try {
  aanvragen = await lijstAanvragen(cfg);
} catch (fout) {
  leesFout = true;
  console.error('[beheer]', fout instanceof Error ? fout.message : fout);
}
const roasts = alleRoasts();

const melding = Astro.url.searchParams.get('melding');
const meldingen: Record<string, string> = {
  bewaard: 'Status bewaard.',
  verwijderd: 'Aanvraag verwijderd.',
  'niet-zeker': 'Niet verwijderd: vink eerst "ik ben zeker" aan.',
  fout: 'Dat is niet gelukt. Probeer het opnieuw.',
};

const open = aanvragen.filter((a) => a.status === 'aanvraag' || a.status === 'onbevestigd');
const bezig = aanvragen.filter((a) => ['goedgekeurd', 'in-opmaak'].includes(a.status));
const rest = aanvragen.filter((a) => !open.includes(a) && !bezig.includes(a));
const groepen = [
  { titel: 'Te beslissen', rijen: open },
  { titel: 'Goedgekeurd en in opmaak', rijen: bezig },
  { titel: 'Afgehandeld', rijen: rest },
];

const datum = (iso: string) =>
  new Intl.DateTimeFormat('nl-BE', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Europe/Brussels',
  }).format(new Date(iso));

const seoProps = { title: 'Beheer: roast-aanvragen', noindex: true };
---

<RoastLayout {...seoProps}>
  <div class="beheer">
    <header class="kop">
      <div>
        <a href="/" class="logo">AI-Studio44</a>
        <h1>Beheer</h1>
      </div>
      <form method="POST" action="/api/beheer/logout" class="uit">
        <span>{beheerder}</span>
        <button type="submit">Uitloggen</button>
      </form>
    </header>

    {melding && meldingen[melding] && <p class="melding" role="status">{meldingen[melding]}</p>}
    {leesFout && <p class="melding fout">De aanvragen konden niet geladen worden. Kijk de Supabase-sleutels na.</p>}

    {
      groepen.map((groep) => (
        <section>
          <h2>
            {groep.titel} <span class="teller">{groep.rijen.length}</span>
          </h2>
          {groep.rijen.length === 0 && <p class="leeg">Niets.</p>}
          {groep.rijen.map((a) => (
            <article class="kaart">
              <div class="kaart-kop">
                <a href={a.website} target="_blank" rel="noopener noreferrer" class="site">
                  {a.website.replace(/^https?:\/\//, '')}
                </a>
                <span class:list={['status', `s-${a.status}`]}>{a.status}</span>
              </div>
              <p class="wie">
                {a.naam ?? 'Geen naam'} · <a href={`mailto:${a.email}`}>{a.email}</a> · {datum(a.created_at)}
              </p>
              <p class="vlaggen">
                {!a.bevestigd_op && <span class="vlag">e-mail niet geverifieerd</span>}
                {!a.domein_komt_overeen && <span class="vlag">e-maildomein past niet bij website</span>}
                {a.toestemming === 'ja' && <span class="vlag ok">resultaat tonen mag</span>}
                {a.toestemming === 'nee' && <span class="vlag">resultaat tonen mag niet</span>}
                {a.type && <span class="vlag neutraal">{a.type}</span>}
              </p>
              <dl>
                {a.bronnen && (<><dt>Bronnen</dt><dd>{a.bronnen}</dd></>)}
                {a.inspiratie && (<><dt>Inspiratie</dt><dd>{a.inspiratie}</dd></>)}
                {a.nota && (<><dt>Nota</dt><dd>{a.nota}</dd></>)}
              </dl>
              <div class="acties">
                {(a.status === 'aanvraag' || a.status === 'onbevestigd') && (
                  <>
                    <form method="POST" action="/api/beheer/status">
                      <input type="hidden" name="id" value={a.id} />
                      <input type="hidden" name="status" value="goedgekeurd" />
                      <button type="submit" class="ja">Goedkeuren</button>
                    </form>
                    <form method="POST" action="/api/beheer/status">
                      <input type="hidden" name="id" value={a.id} />
                      <input type="hidden" name="status" value="geweigerd" />
                      <button type="submit">Weigeren</button>
                    </form>
                  </>
                )}
                <details>
                  <summary>Meer</summary>
                  <form method="POST" action="/api/beheer/status" class="rij">
                    <input type="hidden" name="id" value={a.id} />
                    <label>
                      Status
                      <select name="status">
                        {['aanvraag', 'goedgekeurd', 'geweigerd', 'in-opmaak', 'gepubliceerd', 'verstuurd', 'afgesloten'].map((s) => (
                          <option value={s} selected={s === a.status}>{s}</option>
                        ))}
                      </select>
                    </label>
                    <button type="submit">Bewaar</button>
                  </form>
                  <form method="POST" action="/api/beheer/status" class="rij">
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="actie" value="verwijder" />
                    <label class="check"><input type="checkbox" name="zeker" value="ja" /> ik ben zeker</label>
                    <button type="submit" class="weg">Verwijder definitief</button>
                  </form>
                </details>
              </div>
            </article>
          ))}
        </section>
      ))
    }

    <section>
      <h2>Roasts op de site <span class="teller">{roasts.length}</span></h2>
      <p class="leeg">Deze staan als bestand in het project. De status wijzig je in <code>src/roasts/&lt;slug&gt;/roast.ts</code>.</p>
      {
        roasts.map((r) => (
          <article class="kaart klein">
            <div class="kaart-kop">
              <span class="site">{r.naam}</span>
              <span class:list={['status', { live: isLive(r) }]}>{r.status}</span>
            </div>
            <p class="wie">
              {r.url} · {r.bron === 'dry' ? 'Roast Dry' : 'via website'} · gemeten {r.datum}
              {isLive(r) && (<> · <a href={`/roasts/${r.slug}`}>roast</a> · <a href={`/roasts/${r.slug}/concept`}>concept</a></>)}
            </p>
          </article>
        ))
      }
    </section>
  </div>
</RoastLayout>

<style>
  .beheer {
    max-width: 980px;
    margin: 0 auto;
    padding: 24px 24px 96px;
    font-size: 16px;
    line-height: 1.5;
  }
  .kop {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    border-bottom: 3px solid #111;
    padding-bottom: 20px;
  }
  .logo {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 18px;
    text-decoration: none;
  }
  h1 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 6vw, 68px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 6px 0 0;
  }
  h2 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.02em;
    margin: 44px 0 14px;
  }
  .teller {
    font-size: 16px;
    background: #111;
    color: #fff;
    padding: 2px 9px;
    vertical-align: middle;
  }
  .uit {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 15px;
  }
  button,
  select {
    font: 700 15px Archivo, sans-serif;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid #111;
    background: #fff;
    color: #111;
    cursor: pointer;
  }
  button.ja {
    background: #111;
    color: #fff;
  }
  button.weg {
    border-color: var(--pen);
    color: var(--pen);
  }
  .melding {
    border: 2px solid #111;
    background: #fff8c9;
    padding: 12px 16px;
    font-weight: 700;
    margin: 20px 0 0;
  }
  .melding.fout {
    background: #fff;
    color: var(--pen);
    border-color: var(--pen);
  }
  .leeg {
    color: #555;
    margin: 0 0 12px;
  }
  .kaart {
    border: 2px solid #111;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.12);
    padding: 18px 20px;
    margin-bottom: 18px;
    background: #fff;
  }
  .kaart.klein {
    box-shadow: none;
  }
  .kaart-kop {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
  }
  .site {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .status {
    border: 2px solid #111;
    padding: 3px 10px;
    font-weight: 700;
    font-size: 14px;
  }
  .status.s-aanvraag,
  .status.live {
    background: var(--marker);
  }
  .status.s-goedgekeurd {
    background: #111;
    color: #fff;
  }
  .wie {
    margin: 8px 0 0;
    color: #333;
    overflow-wrap: anywhere;
  }
  .vlaggen {
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .vlag {
    font-size: 13px;
    font-weight: 700;
    padding: 3px 8px;
    border: 2px solid var(--pen);
    color: var(--pen);
  }
  .vlag.ok,
  .vlag.neutraal {
    border-color: #111;
    color: #111;
  }
  dl {
    margin: 12px 0 0;
  }
  dt {
    font-weight: 700;
    font-size: 14px;
    margin-top: 8px;
  }
  dd {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .acties {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
  }
  details {
    flex: 1 1 260px;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 8px;
  }
  .rij {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-end;
    margin-top: 10px;
  }
  .rij label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: 700;
    font-size: 14px;
  }
  .rij label.check {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  code {
    background: #ececec;
    padding: 1px 5px;
  }
</style>
