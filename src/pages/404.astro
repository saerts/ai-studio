---
import RoastTextLayout from '../components/layout/RoastTextLayout.astro';

const seoProps = {
  title: 'Pagina niet gevonden',
  description: 'De pagina die je zoekt bestaat niet of is verplaatst.',
  canonical: 'https://ai-studio44.com/404',
  noindex: true,
};
---

<RoastTextLayout {...seoProps}>
  <p class="roast-hand">oeps...</p>
  <h1 class="roast-404">404</h1>
  <p class="roast-lead">
    Deze pagina bestaat niet meer. Dat overkomt de beste websites. Bij ons
    blijft het bij deze ene.
  </p>
  <p>
    <a href="/" class="roast-cta btn">Terug naar de start</a>
  </p>
</RoastTextLayout>
