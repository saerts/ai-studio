# AI Studio Environment Variables Example
# ⚠️ Copy this file to .env and replace placeholder values with your actual secrets
# ⚠️ NEVER commit .env to git - it contains secrets!

# ============================================================================
# Google Analytics & Tracking (REQUIRED)
# ============================================================================

# Google Tag Manager Container ID
# Get from: https://tagmanager.google.com/
# Format: GTM-XXXXXXX
PUBLIC_GTM_ID=your_gtm_container_id_here

# Google Site Verification Code  
# Get from: https://search.google.com/search-console
# Format: alphanumeric string
PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# ============================================================================
# Site Configuration
# ============================================================================

# Site URL (production)
PUBLIC_SITE_URL=https://ai-studio44.com

# Contact Email
PUBLIC_CONTACT_EMAIL=info@ai-studio44.com

# ============================================================================
# Development Settings
# ============================================================================

# Node environment
NODE_ENV=development

# Enable debug logging
DEBUG=false

# ============================================================================
# Website Roast: aanvragen (alleen op de server, nooit PUBLIC_)
# ============================================================================

# Supabase-project. De Vercel-integratie zet deze automatisch in Vercel;
# lokaal haal je ze op met `vercel env pull` of uit het Supabase-dashboard.
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Resend, voor de bevestigingsmail. Zonder deze sleutel worden aanvragen
# bewaard zonder e-mailverificatie.
RESEND_API_KEY=
ROAST_MAIL_FROM="AI-Studio44 <hi@ai-studio44.com>"
ROAST_NOTIFY_TO=hi@ai-studio44.com

# Wie mag inloggen op /beheer (door komma's gescheiden). Leeg = beheer uit.
# De inloglink komt van Supabase Auth.
ROAST_ADMIN_EMAILS=
